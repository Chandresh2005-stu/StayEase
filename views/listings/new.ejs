<% layout("layouts/boilerplate")%>

    <div class="row">
        <div class="col-sm-8 offset-2">

            <body>
                <h3>Create New Listing</h3>
                <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

                    <div class="mt-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" type="text" class="form-control" placeholder="Add a catchy title" required>
                        <div class="valid-feedback">Title looks good!</div>
                    </div>

                    <div class="mt-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" class="form-control" placeholder="Describe your property" required></textarea>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>
                    <div class="mt-3">
                        <label for="image" class="form-label">Image</label>
                        <input name="listing[image]" placeholder="Upload Listing Image" class="form-control" type="file" required>
                    </div>
                    <div class="row">
                        <div class="mt-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input name="listing[price]" placeholder="eg: 1800" type="number" class="form-control" required>
                            <div class="invalid-feedback">Please enter a valid price</div>
                        </div>

                        <div class="mt-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" placeholder="eg: India" type="text" class="form-control" required>
                                                        <div class="invalid-feedback">Please enter a valid country</div>

                        </div>
                    </div>

                    <div class="mt-3">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" placeholder="eg: Lucknow" type="text" class="form-control" required>
                                                    <div class="invalid-feedback">Please enter a valid location</div>

                    </div>


                    <button class="btn btn-dark add-btn mt-3">Add</button>
                    <br><br>
                </form>
            </body>
        </div>
    </div>